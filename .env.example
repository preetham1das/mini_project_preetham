# ==============================================================================
# Copernicus Data Space Ecosystem (CDSE) / Sentinel Hub API Configuration
# ==============================================================================
# 1. Register an account at: https://dataspace.copernicus.eu/
# 2. Generate OAuth2 client credentials in Copernicus Data Space / Sentinel Hub Dashboard:
#    https://sh.dataspace.copernicus.eu/
# 3. Copy this file to '.env' and fill in your actual credentials.

SENTINEL_CLIENT_ID=your_sentinel_client_id_here
SENTINEL_CLIENT_SECRET=your_sentinel_client_secret_here

# Optional: Instance ID if using custom configurations/evalscripts
SENTINEL_INSTANCE_ID=

# CDSE / Sentinel Hub OAuth2 and Base API endpoints
SENTINEL_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
SENTINEL_BASE_URL=https://sh.dataspace.copernicus.eu/api/v1
